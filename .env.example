# Shared password members type on the login screen
GROUP_PASSWORD=changeme

# Public URL of the deployed site, used in invitation emails
BETTER_AUTH_URL=https://owyverns-production.up.railway.app

# SQLite location. On Railway point this at a mounted volume so the database
# survives redeploys, e.g. file:/data/local.db
DB_URL=file:./local.db

# Email (Resend). Railway blocks outbound SMTP on Free/Trial/Hobby plans,
# so mail goes over Resend's HTTPS API instead of Gmail SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Wyvern Club <onboarding@resend.dev>"
